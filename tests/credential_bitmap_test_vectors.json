{
  "format": "Tuya credential bitmap: repeating [1-based shard, bitmap] pairs; ID=(shard-1)*8+bit",
  "valid": [
    {
      "name": "TYZS5 fingerprint",
      "hex": "010a0302",
      "expected_ids": [
        1,
        3,
        17
      ]
    },
    {
      "name": "TYZS3 fingerprint",
      "hex": "0104026c",
      "expected_ids": [
        2,
        10,
        11,
        13,
        14
      ]
    },
    {
      "name": "TYZS3 password",
      "hex": "01010280",
      "expected_ids": [
        0,
        15
      ]
    },
    {
      "name": "TYZS3 card",
      "hex": "02100301",
      "expected_ids": [
        12,
        16
      ]
    },
    {
      "name": "TYZS3 face DP93",
      "hex": "0240",
      "expected_ids": [
        14
      ]
    },
    {
      "name": "empty",
      "hex": "",
      "expected_ids": []
    }
  ],
  "invalid": [
    {
      "name": "odd length",
      "hex": "01",
      "expected_error": "odd length"
    },
    {
      "name": "fragment zero",
      "hex": "0001",
      "expected_error": "fragment 0"
    },
    {
      "name": "invalid hex",
      "hex": "zz",
      "expected_error": "invalid hex"
    }
  ]
}
